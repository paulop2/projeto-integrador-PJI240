# Copy to .dev.vars for `npm run dev:pages`. These are Pages Functions bindings,
# never VITE_* variables. Use separate identities and secrets for each environment.
BETTER_AUTH_URL=http://localhost:8788
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
MARATONA_ZITADEL_ISSUER_URL=http://localhost:8080
MARATONA_ZITADEL_WEB_CLIENT_ID=from-zitadel-kit-app-env
MARATONA_ZITADEL_WEB_CLIENT_SECRET=from-zitadel-kit-app-env
MARATONA_ZITADEL_LOGIN_ORG_ID=from-zitadel-kit-app-env
MARATONA_ZITADEL_LOGIN_PAT=from-zitadel-kit-app-env
MARATONA_ZITADEL_MANAGEMENT_PAT=from-zitadel-kit-app-env
# Optional. Leave empty to hide Google sign-in.
MARATONA_ZITADEL_GOOGLE_IDP_ID=
