{
  "name": "plataforma-offline-questoes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --exclude 'e2e/**'",
    "test:frontend": "vitest run src/app",
    "test:data": "vitest run --config scripts/vitest-data.config.ts",
    "test:backend": "vitest run tests/backend.test.ts",
    "test:offline": "vitest run tests/offline.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "import:enem": "vite-node --script scripts/import-enem.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:contracts": "vitest run tests/contracts.test.ts",
    "typecheck:contracts": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vitest": "^3.0.7",
    "wrangler": "^4.0.0"
  }
}
